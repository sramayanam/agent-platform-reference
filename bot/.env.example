# Bot identity: app registration for the bot, credential = user-assigned managed identity (federated credential, no secret)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=FederatedCredentials
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<bot-app-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__FEDERATEDCLIENTID=<bot-uami-client-id>
AZURE_CLIENT_ID=<bot-uami-client-id>
# Teams SSO handler -> Azure Bot OAuth connection (scope api://<blueprint-app-id>/agent.invoke)
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SSO__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=teams-sso
# APIM gateway as reached from inside the VNet (resolves to APIM's private address)
APIM_GATEWAY_URL=https://<apim-name>.azure-api.net
# Optional: subscription key if the agents API requires one. Store it as a Container App secret, never in source.
APIM_SUBSCRIPTION_KEY=
DEFAULT_AGENT_NAME=graph-profile-agent
FOUNDRY_API_VERSION=v1
