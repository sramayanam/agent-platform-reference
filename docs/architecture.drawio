        <mxCell id="apim-to-pe" edge="1" parent="1" source="apim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6944CA;exitX=0.97;exitY=1;entryX=0.566;entryY=0.116;entryDx=0;entryDy=0;entryPerimeter=0;" target="foundry-pe" value="">
