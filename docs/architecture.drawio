  <diagram id="teams-direct-reference" name="Teams direct - secured reference">
    <mxGraphModel dx="1573" dy="788" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1740" background="#F6F7FC" math="0" shadow="0">
