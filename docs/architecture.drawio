          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="service-to-edge" edge="1" parent="1" source="bot-service" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#397BDC;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="front-door" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-to-apim" edge="1" parent="1" source="front-door" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#128573;exitX=0.5;exitY=1;entryX=0.7;entryY=0;fontColor=#536176;fontSize=13;labelBackgroundColor=#F6F7FC;" target="apim" value="All channels, HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apim-to-bot" edge="1" parent="1" source="apim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#397BDC;exitX=0.16;exitY=1;entryX=0.5;entryY=0;fontColor=#326CB6;fontSize=12;labelBackgroundColor=#EDF2FF;" target="bot" value="1. Activity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bot-to-apim" edge="1" parent="1" source="bot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#397BDC;exitX=1;exitY=0.4;entryX=0.42;entryY=1;fontColor=#326CB6;fontSize=12;labelBackgroundColor=#EDF2FF;" target="apim" value="2. /agents + user token">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="14" as="offset" />
            <Array as="points">
              <mxPoint x="330" y="866" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bot-to-fw" edge="1" parent="1" source="bot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#397BDC;dashed=1;" target="firewall" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fw-to-service" edge="1" parent="1" source="firewall" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#397BDC;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.7;fontColor=#326CB6;fontSize=12;labelBackgroundColor=#F6F7FC;" target="bot-service" value="">
          <mxGeometry relative="1" as="geometry">
