          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="foundry-to-graph" edge="1" parent="1" source="foundry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6944CA;exitX=0.4;exitY=1;entryX=0.246;entryY=0;fontColor=#536176;fontSize=13;labelBackgroundColor=#F6F7FC;" target="graph" value="Graph calls as the signed-in user">
