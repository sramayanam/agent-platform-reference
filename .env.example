# Copy to .env (git-ignored) and fill in. Scripts read this file; no secrets belong here.
AZURE_TENANT_ID=<tenant-id>
AGENT_BLUEPRINT_APP_ID=<blueprint-app-id>
AGENT_BLUEPRINT_SP_OBJECT_ID=<blueprint-principal-object-id>
BOT_APP_ID=<bot-app-id>
TEST_CLIENT_ID=<public-test-client-app-id>        # optional: device-code test client consented for agent.invoke
GRAPH_DELEGATED_SCOPES="User.Read Calendars.Read Mail.Send"

# Front Door and APIM
FRONT_DOOR_HOST=<front-door-host>
MCP_SERVER_URL=https://<front-door-host>/agents-mcp/mcp
APIM_GATEWAY_URL=https://<front-door-host>              # public route (factory smoke test expects 401 without a token)
APIM_DIRECT_URL=https://<apim-name>.azure-api.net       # from inside the VNet (trace script)
APIM_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.ApiManagement/service/<apim-name>
APIM_SUBSCRIPTION_NAME=agents-bot

# Factory (agent publish)
ACR_NAME=<acr-name>
AZURE_AI_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>
SPONSOR_OBJECT_ID=<sponsor-user-object-id>
